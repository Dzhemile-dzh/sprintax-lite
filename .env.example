# Copy to .env for local PHP:  copy .env.example .env
#
# Docker Compose interpolates APP_ENV, APP_DEBUG, APP_SECRET, and MAILER_FROM from
# the host environment / this file. MAILER_DSN is hardcoded in docker-compose.yml
# as smtp://mailer:1025 (Mailpit) so a host 127.0.0.1 DSN cannot leak into containers.
#
# Do not commit .env, .env.dev, or .env.test. Put machine secrets in .env.local.

APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# Local PHP: Mailpit on the host (inbox: http://localhost:8025).
# Docker always uses smtp://mailer:1025.
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM=noreply@localhost
