# Copy to .env for local PHP:  copy .env.example .env
# Docker Compose injects its own variables and does not need this file.
#
# Do not commit .env, .env.dev, or .env.test. Put machine secrets in .env.local.

APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# Docker Compose defaults to smtp://mailer:1025 (Mailpit inbox: http://localhost:8025).
# Mailpit does not deliver to Gmail. For real SMTP put a DSN in .env.local, e.g.
# MAILER_DSN=smtp://USER:APP_PASSWORD@smtp.gmail.com:587
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM=noreply@localhost
