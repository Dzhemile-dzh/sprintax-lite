{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Review {{ questionnaire.name }}{% endblock %}

{% block body %}
    <h1>Review</h1>
    <p class="page-lead">{{ questionnaire.name }}</p>

    {% for stepView in steps %}
        <section class="review-section">
            <div class="review-section__header">
                <h2>{{ stepView.step.position }}. {{ stepView.step.title }}</h2>
                {% if canFinalize %}
                    {{ ui.link(
                        path('client_wizard_step', {id: submission.id, stepId: stepView.step.id}),
                        'Edit this step',
                        'btn btn-secondary btn-sm'
                    ) }}
                {% endif %}
            </div>
            <dl class="answer-list">
                {% for item in stepView.questions %}
                    <div class="answer-row">
                        <dt>{{ item.question.label }}</dt>
                        <dd>{{ ui.answer(item.answer) }}</dd>
                    </div>
                {% endfor %}
            </dl>
        </section>
    {% endfor %}

    <div class="page-toolbar">
        {% if canFinalize %}
            <form method="post" action="{{ path('client_wizard_finalize', {id: submission.id}) }}" class="inline">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('finalize-' ~ submission.id) }}">
                {{ ui.submit('Submit') }}
            </form>
        {% else %}
            {{ ui.link(path('client_wizard_done', {id: submission.id}), 'View confirmation', 'btn btn-secondary') }}
            {{ ui.pdf_download(submission) }}
        {% endif %}
    </div>
{% endblock %}
