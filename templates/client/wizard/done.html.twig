{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Submitted{% endblock %}

{% block body %}
    {{ ui.page_header('Submitted', path('client_home'), 'Back to client area') }}

    {% if submission.status.value == 'pdf_ready' %}
        <p class="page-lead">{{ questionnaire.name }} is ready to download.</p>
        <div class="page-toolbar">
            {{ ui.pdf_download(submission) }}
            {{ ui.link(path('client_wizard_review', {id: submission.id}), 'View answers', 'btn btn-secondary') }}
        </div>
    {% else %}
        <p class="page-lead">{{ questionnaire.name }} has been submitted.</p>
        {{ ui.pdf_download(submission) }}
        <div class="page-toolbar">
            {{ ui.link(path('client_wizard_review', {id: submission.id}), 'View answers', 'btn btn-secondary') }}
        </div>
    {% endif %}
{% endblock %}
