{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Submitted{% endblock %}

{% block body %}
    <h1>Submitted</h1>
    {% if submission.status.value == 'pdf_ready' %}
        <p role="status">{{ questionnaire.name }} is ready. {{ ui.pdf_download(submission) }}</p>
    {% else %}
        <p>{{ questionnaire.name }} has been submitted.</p>
        <p>{{ ui.pdf_download(submission) }}</p>
    {% endif %}
    <p>{{ ui.link(path('client_wizard_review', {id: submission.id}), 'View answers') }}</p>
    <p>{{ ui.link(path('client_home'), 'Back to client area') }}</p>
{% endblock %}
