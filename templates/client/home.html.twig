{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Client{% endblock %}

{% block body %}
    <h1>Client</h1>

    {% if questionnaires is empty %}
        <p>No questionnaires are available yet.</p>
    {% else %}
        <ul>
            {% for questionnaire in questionnaires %}
                {% set submission = submissions[questionnaire.id] ?? null %}
                <li>
                    <strong>{{ questionnaire.name }}</strong>
                    {% if submission %}
                        {% if submission.status.value == 'in_progress' %}
                            {{ ui.link(path('client_wizard_step', {id: submission.id, stepId: submission.currentStep.id}), 'Continue') }}
                        {% else %}
                            {{ ui.link(path('client_wizard_review', {id: submission.id}), 'View answers') }}
                        {% endif %}
                    {% else %}
                        <form method="post" action="{{ path('client_wizard_start', {questionnaireId: questionnaire.id}) }}" class="inline">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('start-questionnaire') }}">
                            {{ ui.submit('Start') }}
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
