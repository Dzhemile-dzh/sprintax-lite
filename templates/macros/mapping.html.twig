{% macro picker_styles() %}
    <style>
        .pdf-picker { margin: 1.25rem 0; }
        .pdf-picker-toolbar { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin-bottom: 0.5rem; }
        .pdf-picker-stage {
            position: relative;
            display: inline-block;
            max-width: 100%;
            border: 1px solid #999;
            background: #eee;
            line-height: 0;
            cursor: crosshair;
        }
        .pdf-picker-stage canvas { max-width: 100%; height: auto; display: block; }
        .pdf-picker-mark {
            position: absolute;
            width: 12px;
            height: 12px;
            margin: -6px 0 0 -6px;
            border: 2px solid #b00020;
            border-radius: 50%;
            background: rgba(176, 0, 32, 0.2);
            pointer-events: none;
        }
        .pdf-picker-hint { color: #444; margin: 0.5rem 0 0; }
        .pdf-picker-missing { color: #666; }
    </style>
{% endmacro %}

{% macro picker(pdf_template_url, page_field_id, x_field_id, y_field_id) %}
    <section class="pdf-picker" aria-label="PDF coordinate picker">
        <h2>Coordinate picker</h2>
        {% if pdf_template_url %}
            <div class="pdf-picker-toolbar">
                <button type="button" id="pdf-picker-prev">Previous page</button>
                <span id="pdf-picker-page-label" aria-live="polite">Page 1</span>
                <button type="button" id="pdf-picker-next">Next page</button>
            </div>
            <div class="pdf-picker-stage" id="pdf-picker-stage">
                <canvas id="pdf-picker-canvas"></canvas>
                <span class="pdf-picker-mark" id="pdf-picker-mark" hidden></span>
            </div>
            <p class="pdf-picker-hint">Click the form to set X/Y in millimetres from the top-left corner. Page changes update the Page field.</p>
        {% else %}
            <p class="pdf-picker-missing">No blank PDF template is available for this form type. Enter coordinates manually, or place <code>resources/pdf/{formType}.pdf</code> and reload.</p>
        {% endif %}
    </section>
{% endmacro %}

{% macro picker_script(pdf_template_url, page_field_id, x_field_id, y_field_id) %}
    {% if pdf_template_url %}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script>
            (function () {
                if (!window['pdfjsLib']) {
                    return;
                }

                const pdfUrl = {{ pdf_template_url|json_encode|raw }};
                const pageField = document.getElementById({{ page_field_id|json_encode|raw }});
                const xField = document.getElementById({{ x_field_id|json_encode|raw }});
                const yField = document.getElementById({{ y_field_id|json_encode|raw }});
                const canvas = document.getElementById('pdf-picker-canvas');
                const stage = document.getElementById('pdf-picker-stage');
                const mark = document.getElementById('pdf-picker-mark');
                const pageLabel = document.getElementById('pdf-picker-page-label');
                const prev = document.getElementById('pdf-picker-prev');
                const next = document.getElementById('pdf-picker-next');

                if (!pageField || !xField || !yField || !canvas || !stage || !mark || !pageLabel || !prev || !next) {
                    return;
                }

                pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

                let pdfDoc = null;
                let pageCount = 1;
                let currentPage = Math.max(1, parseInt(pageField.value, 10) || 1);
                let pageWidthMm = 215.9;
                let pageHeightMm = 279.4;
                const POINTS_TO_MM = 25.4 / 72;

                function syncMark() {
                    const x = parseFloat(xField.value);
                    const y = parseFloat(yField.value);
                    if (!Number.isFinite(x) || !Number.isFinite(y) || canvas.width === 0) {
                        mark.hidden = true;
                        return;
                    }

                    const displayWidth = canvas.clientWidth;
                    const displayHeight = canvas.clientHeight;
                    const left = (x / pageWidthMm) * displayWidth;
                    const top = (y / pageHeightMm) * displayHeight;
                    mark.style.left = left + 'px';
                    mark.style.top = top + 'px';
                    mark.hidden = false;
                }

                function renderPage(pageNumber) {
                    return pdfDoc.getPage(pageNumber).then(function (page) {
                        const unscaled = page.getViewport({ scale: 1 });
                        pageWidthMm = unscaled.width * POINTS_TO_MM;
                        pageHeightMm = unscaled.height * POINTS_TO_MM;

                        const scale = Math.min(1.5, 720 / unscaled.width);
                        const viewport = page.getViewport({ scale: scale });
                        canvas.width = viewport.width;
                        canvas.height = viewport.height;

                        return page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise.then(function () {
                            currentPage = pageNumber;
                            pageField.value = String(pageNumber);
                            pageLabel.textContent = 'Page ' + pageNumber + ' of ' + pageCount;
                            prev.disabled = pageNumber <= 1;
                            next.disabled = pageNumber >= pageCount;
                            syncMark();
                        });
                    });
                }

                stage.addEventListener('click', function (event) {
                    const rect = canvas.getBoundingClientRect();
                    const xMm = ((event.clientX - rect.left) / rect.width) * pageWidthMm;
                    const yMm = ((event.clientY - rect.top) / rect.height) * pageHeightMm;
                    xField.value = (Math.round(xMm * 10) / 10).toFixed(1);
                    yField.value = (Math.round(yMm * 10) / 10).toFixed(1);
                    syncMark();
                });

                pageField.addEventListener('change', function () {
                    const page = Math.max(1, Math.min(pageCount, parseInt(pageField.value, 10) || 1));
                    renderPage(page);
                });
                xField.addEventListener('input', syncMark);
                yField.addEventListener('input', syncMark);
                prev.addEventListener('click', function () {
                    if (currentPage > 1) {
                        renderPage(currentPage - 1);
                    }
                });
                next.addEventListener('click', function () {
                    if (currentPage < pageCount) {
                        renderPage(currentPage + 1);
                    }
                });

                pdfjsLib.getDocument(pdfUrl).promise.then(function (doc) {
                    pdfDoc = doc;
                    pageCount = doc.numPages;
                    return renderPage(Math.min(currentPage, pageCount));
                }).catch(function () {
                    pageLabel.textContent = 'Could not load the PDF template.';
                });
            })();
        </script>
    {% endif %}
{% endmacro %}
