<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% if awaiting_pdf is defined and awaiting_pdf %}
            <meta http-equiv="refresh" content="5">
        {% endif %}
        <title>{% block title %}Sprintax-Lite{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
        {% set css_base = app.request.basePath %}
        <link rel="stylesheet" href="{{ css_base }}/css/tokens.css">
        <link rel="stylesheet" href="{{ css_base }}/css/base.css">
        <link rel="stylesheet" href="{{ css_base }}/css/layout.css">
        <link rel="stylesheet" href="{{ css_base }}/css/forms.css">
        <link rel="stylesheet" href="{{ css_base }}/css/buttons.css">
        <link rel="stylesheet" href="{{ css_base }}/css/components.css">
        <link rel="stylesheet" href="{{ css_base }}/css/lists.css">
        <link rel="stylesheet" href="{{ css_base }}/css/metrics.css">
        <link rel="stylesheet" href="{{ css_base }}/css/builder.css">
        <link rel="stylesheet" href="{{ css_base }}/css/review.css">
        <link rel="stylesheet" href="{{ css_base }}/css/pdf-picker.css">
        <link rel="stylesheet" href="{{ css_base }}/css/auth.css">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="app {% block body_class %}{% endblock %}">
        {% import 'macros/ui.html.twig' as ui %}
        {% set extra_links = {} %}
        {% if is_granted('ROLE_ADMIN') %}
            {% set extra_links = extra_links|merge({
                'Admin': path('admin_home'),
                'Submissions': path('admin_submissions'),
                'Analytics': path('admin_analytics'),
            }) %}
        {% endif %}
        {% if is_granted('ROLE_CLIENT') %}
            {% set extra_links = extra_links|merge({'Client area': path('client_home')}) %}
        {% endif %}
        <header class="app-header">
            <div class="app-header__inner">
                <a class="app-brand" href="{{ path('app_home') }}">
                    <span class="app-brand__name">sprintax-lite</span>
                    <span class="app-brand__tag">Secure tax questionnaire</span>
                </a>
                {{ ui.nav(
                    app.user,
                    path('app_login'),
                    path('app_register'),
                    path('app_logout'),
                    csrf_token('logout'),
                    extra_links
                ) }}
            </div>
        </header>
        <main class="app-main">
            {% set account_created_messages = app.flashes('account_created') %}
            {{ ui.flashes(app.flashes()) }}
            <div class="app-panel">
                {% block body %}{% endblock %}
            </div>
        </main>
        <footer class="app-footer">
            <div class="app-footer__inner">Sprintax-Lite · confidential client portal</div>
        </footer>
        {{ ui.account_created_modal(account_created_messages, path('app_login')) }}
        <script>
            (function () {
                const modal = document.getElementById('account-created-modal');
                if (!modal) {
                    return;
                }

                function closeModal() {
                    modal.remove();
                }

                modal.querySelectorAll('[data-modal-close]').forEach(function (el) {
                    el.addEventListener('click', function () {
                        closeModal();
                    });
                });

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        closeModal();
                    }
                });
            })();
        </script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
