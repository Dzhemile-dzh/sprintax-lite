{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {% for field in form %}
            {% if not field.rendered %}
                {{ ui.field(field) }}
            {% endif %}
        {% endfor %}
        {{ ui.submit('Save') }}
    {{ form_end(form) }}
{% endblock %}
