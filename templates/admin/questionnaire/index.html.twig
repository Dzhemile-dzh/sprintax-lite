{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Admin questionnaires{% endblock %}

{% block body %}
    <h1>Questionnaires</h1>
    <p class="page-lead">Build and manage tax questionnaire structure, mappings, and history.</p>

    <div class="page-toolbar">
        {{ ui.link(path('admin_questionnaire_new'), 'New questionnaire', 'btn btn-primary') }}
        {{ ui.link(path('admin_submissions'), 'Submissions', 'btn btn-secondary') }}
        {{ ui.link(path('admin_analytics'), 'Analytics', 'btn btn-secondary') }}
    </div>

    {% if questionnaires is empty %}
        <p class="empty-state">No questionnaires yet.</p>
    {% else %}
        <ul class="entity-list">
            {% for questionnaire in questionnaires %}
                <li class="entity-list__item">
                    <div class="entity-list__main">
                        {{ ui.link(
                            path('admin_questionnaire_show', {id: questionnaire.id}),
                            questionnaire.name,
                            'entity-list__title'
                        ) }}
                        <span class="badge badge--soft">{{ questionnaire.formType.label }}</span>
                    </div>
                    <div class="entity-list__actions">
                        {{ ui.link(path('admin_questionnaire_show', {id: questionnaire.id}), 'Open', 'btn btn-secondary') }}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
