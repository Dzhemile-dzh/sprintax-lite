{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Create account{% endblock %}

{% block body %}
    <h1>Create a client account</h1>
    <p>Administrators cannot self-register.</p>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ ui.field(form.email) }}
        {{ ui.field(form.plainPassword.first) }}
        {{ ui.field(form.plainPassword.second) }}
        {{ ui.submit('Create account') }}
    {{ form_end(form) }}

    <p><a href="{{ path('app_login') }}">Already have an account? Sign in</a></p>
{% endblock %}
